      <column caption='Sale Category' datatype='string' name='[Calculation_6430165729091585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sale Amount] &gt;= 500000 THEN &quot;High&quot;&#10;ELSEIF [Sale Amount] &gt;= 200000 THEN &quot;Medium&quot;&#10;ELSE &quot;Low&quot;&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_6430165800779780]' role='measure' type='quantitative'>
